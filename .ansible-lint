---
exclude_paths:
  - .github/
  - .ansible/
  - .claude/
  - changelogs/
  - tests/
  - roles/binary_bundler/tests/
  - roles/client_config/tests/
  - roles/demo_certs/tests/
  - roles/redpanda_broker/tests/
  - roles/redpanda_connect/tests/
  - roles/redpanda_console/tests/
  - roles/redpanda_logging/tests/
  - roles/system_setup/tests/
  - roles/sysctl_setup/tests/
  - roles/user_management/tests/

enable_list:
  - yaml
  - empty-string-compare
  - args

profile: production

skip_list:
  - risky-shell-pipe
  - jinja[spacing]
  - yaml[brackets]
  - yaml[line-length]
  - yaml[trailing-spaces]
  - var-naming[no-role-prefix]
